name: Build Mod
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
      # 必须加这行：赋予 gradlew 执行权限
      - name: Grant execute permission for gradlew
        run: chmod +x gradlew
      # 必须加这行：先初始化，避免找不到 build.gradle
      - name: Setup Gradle
        run: ./gradlew clean
      - name: Build with Gradle
        run: ./gradlew jar
      - name: Upload jar
        uses: actions/upload-artifact@v4
        with:
          name: mod-jar
          path: build/libs/*.jar